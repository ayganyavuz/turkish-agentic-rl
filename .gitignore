__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Anahtar sizmasin: .env ve her turlu yedegi disarida, ornek dosya iceride.
.env
.env.*
!.env.example

# Rollout ciktilari ve loglar yeniden uretilebilir; repoya girmesin.
# data/ tumden dislanamiyor: split.json donmus bir yapit ve Colab'de lazim.
# (Dizin dislanirsa git icindeki dosyayi geri alamiyor, o yuzden data/*)
data/*
!data/split.json
# Bant olcumu pahali (A100'de ~20 dk) ve deneyin kaydi; kaybolmasin.
!data/bant-*.jsonl

# Kapilarda reddedilen adaylar: teshis icin tutuluyor, veri setinin parcasi degil.
envs_gen/_red/
envs_gen_code/_red/
